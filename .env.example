# Archivo de ejemplo de .env
# El archivo .env nunca se sube al repositorio.

# Base de datos
DB_HOST=host/ip
DB_PORT=port
DB_USER=user
DB_PASSWORD=pass
DB_NAME=db
DB_POOL_MIN=1
DB_POOL_MAX=10

# Tokens JWT
# Genera la clave con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=secret_key
JWT_ALGORITHM=algorithm
JWT_EXPIRE_MINUTES=minutes

# CORS (si hay varios orígenes, sepáralos por comas)
CORS_ORIGINS=protocol://hostname_domain_ip:port
